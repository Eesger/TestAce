# === Twitter / X API ===
# Create an app at developer.twitter.com, enable OAuth 2.0 with PKCE.
# Required scopes: tweet.read  users.read  bookmark.read  offline.access
TWITTER_CLIENT_ID=your_client_id_here
TWITTER_CLIENT_SECRET=your_client_secret_here

# Populated automatically after running `xarchiver auth`
TWITTER_ACCESS_TOKEN=
TWITTER_REFRESH_TOKEN=
TWITTER_TOKEN_EXPIRES_AT=

# Your numeric X user ID — run `xarchiver auth` and it is set automatically,
# or find it at https://tweeterid.com
TWITTER_USER_ID=

# === Database ===
# Path where the SQLite file is stored (created on first sync)
DB_PATH=./data/bookmarks.db

# === Embeddings ===
# Any sentence-transformers model; all-MiniLM-L6-v2 is fast and small (80 MB)
EMBED_MODEL=all-MiniLM-L6-v2

# === Idea Extraction (Claude API) ===
# Get your key at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...
# Model used for idea extraction — haiku is fast and cheap for batch processing
IDEA_MODEL=claude-haiku-4-5-20251001

# === Scheduler ===
# Option A: run every N minutes (default 1440 = once per day)
SYNC_INTERVAL_MINUTES=1440
# Option B: cron expression (overrides interval if set) — e.g. every day at 08:00
# SYNC_CRON=0 8 * * *

# === Logging ===
LOG_LEVEL=INFO
